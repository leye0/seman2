-            for symbol in rule.rhs:
-                self._bit(symbol.category)
-        compiled: list[CompiledRule] = []
-        first: dict[int, list[int]] = {}
-        for index, rule in enumerate(grammar):
-            rhs_ids = tuple(symbol.category_id for symbol in rule.rhs)
-            if not rhs_ids:
-                continue
-            item = CompiledRule(
-                index=len(compiled),
-                rule=rule,
-                lhs_id=rule.lhs.category_id,
-                lhs_mask=self._bit(rule.lhs.category),
-                rhs_ids=rhs_ids,
-                rhs_masks=tuple(self._bit(symbol.category) for symbol in rule.rhs),
-            )
-            compiled.append(item)
-            first.setdefault(rhs_ids[0], []).append(item.index)
-        self.rules = tuple(compiled)
-        self.first = {key: tuple(value) for key, value in first.items()}
