-                    "surface": candidate.surface,
-                    "lemma": candidate.lemma,
-                    "sense_id": candidate.sense_id,
-                }),
-                bindings=bindings,
-                _sig=analysis.analysis_id,
-            )
-            self.item_cache[cache_key] = item
-            return item
-
-        assert analysis.rule_index is not None
