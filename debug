-    def parse_lattice(
-        self,
-        lattice: LexicalLattice,
-        *,
-        beam: int,
-        max_items: int,
-        goal_category: str,
-    ) -> ParseResult:
-        length = len(lattice.text)
-        if length > 160:
-            structural_beam, materialized_beam, item_budget = 1, 2, min(max_items, 16_000)
-        elif length > 80:
-            structural_beam, materialized_beam, item_budget = 1, 4, min(max_items, 24_000)
-        elif length > 40:
-            structural_beam, materialized_beam, item_budget = 2, 8, min(max_items, 32_000)
-        else:
-            structural_beam, materialized_beam, item_budget = 2, 8, max_items
-        # Packed child nodes retain their alternatives.  The per-slot path
-        # cap only prevents equivalent long-distance structural products.
-        forest = _VectorForest(
-            self, lattice, structural_beam=structural_beam, max_items=item_budget,
-        )
-        root_nodes = forest.recognize(goal_category)
-        materialized_beam = max(1, min(beam, materialized_beam))
-        materializer = _Materializer(self, forest, beam=materialized_beam)
-        roots: list[ChartItem] = []
-        for node in root_nodes:
-            for analysis in materializer.analyses(node.node_id):
-                roots.append(materializer.item(analysis))
-        roots.sort(key=lambda item: item.score, reverse=True)
-        if len(roots) > materialized_beam:
-            roots = roots[:materialized_beam]
-
-        packed: dict[tuple[int, int, int], PackedNode] = {}
-        seen_items: set[int] = set()
-
-        def pack(item: ChartItem) -> None:
-            identity = id(item)
-            if identity in seen_items:
-                return
-            seen_items.add(identity)
-            for child in item.children:
-                pack(child)
-            key = item.key
-            node = packed.get(key)
-            signature = item.signature()
-            if node is None:
-                node = PackedNode(item.start, item.end, item.category, item)
-                packed[key] = node
-            if signature not in node.seen_signatures:
-                node.add(item, signature)
-
-        for root in roots:
-            pack(root)
-        stats = {
-            "engine": "vector",
-            "lexical_spans": forest.lexical_spans,
-            "category_bits": len(self._bits),
-            "forest_nodes": len(forest.nodes),
-            "structural_derivations": forest.derivation_count,
-            "partial_paths": forest.partial_count,
-            "recognition_operations": forest.operations,
-            "unification_attempts": materializer.unification_attempts,
-            "compact_analyses": materializer.analysis_count,
-            "materialized_items": len(materializer.item_cache),
-            "budget_exceeded": forest.budget_exceeded,
-            # Compatibility with existing diagnostics.
-            "expanded": len(forest.nodes),
-            "pushed": len(forest.nodes),
-            "packed_nodes": len(packed),
-            "partials": forest.partial_count,
-            "goal_saturated": len(roots) >= materialized_beam,
-        }
-        return ParseResult(
-            text=lattice.text,
-            lattice=lattice,
-            packed=packed,
-            roots=tuple(roots),
-            completed=bool(roots),
-            stats=stats,
-            shared_forest=forest,
-        )
