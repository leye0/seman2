-class _VectorForest:
-    """Feature-blind shared forest; every path contains node ids only."""
-
-    def __init__(
-        self,
-        compiled: VectorGrammar,
-        lattice: LexicalLattice,
-        *,
-        structural_beam: int,
-        max_items: int,
-    ) -> None:
-        self.compiled = compiled
-        self.lattice = lattice
-        self.text = lattice.text
-        self.structural_beam = structural_beam
-        self.max_items = max_items
-        self.nodes: list[ForestNode] = []
-        self.by_key: dict[tuple[int, int, int], ForestNode] = {}
-        self.by_start_category: dict[tuple[int, int], list[ForestNode]] = {}
-        self.waiting: dict[tuple[int, int], list[PartialPath]] = {}
-        self.partial_seen: dict[tuple[int, int, int, int], set[tuple[int, ...]]] = {}
-        self.agenda: list[int] = []
-        self.operations = 0
-        self.partial_count = 0
-        self.derivation_count = 0
-        self.lexical_spans = 0
-        self.budget_exceeded = False
-
-    def _next_start(self, end: int) -> int:
-        separators = ' \t\r\n"\u201c\u201d\u2018\u2019'
-        while end < len(self.text) and self.text[end] in separators:
-            end += 1
-        return end
-
-    def _root_span(self, start: int, end: int) -> bool:
-        if start != 0:
-            return False
-        if end == len(self.text):
-            return True
-        tail = self.text[end:].strip().strip(".!?;:,\"\u201c\u201d\u2018\u2019")
-        return end < len(self.text) and not tail
-
-    def _add_derivation(
-        self,
-        start: int,
-        end: int,
-        category_id: int,
-        category: str,
-        mask: int,
-        derivation: Derivation,
-        signature: Hashable,
-    ) -> ForestNode:
-        key = (start, end, category_id)
-        node = self.by_key.get(key)
-        if node is None:
-            node = ForestNode(len(self.nodes), start, end, category_id, category, mask)
-            self.nodes.append(node)
-            self.by_key[key] = node
-            self.by_start_category.setdefault((start, category_id), []).append(node)
-            self.agenda.append(node.node_id)
-        if signature not in node.seen:
-            node.seen.add(signature)
-            node.derivations.append(derivation)
-            self.derivation_count += 1
-        return node
-
-    def _seed_lexicon(self) -> None:
-        grouped: dict[tuple[int, int], dict[int, list[LexicalCandidate]]] = {}
-        for candidate in self.lattice.candidates:
-            category_id = intern(candidate.category)
-            grouped.setdefault((candidate.span_start, candidate.span_end), {}).setdefault(category_id, []).append(candidate)
-        self.lexical_spans = len(grouped)
-        for (start, end), categories in grouped.items():
-            span_mask = 0
-            category_rows: list[tuple[int, str, int, tuple[LexicalCandidate, ...]]] = []
-            for category_id, candidates in categories.items():
-                category = candidates[0].category
-                bit = self.compiled.bit(category)
-                span_mask |= bit
-                category_rows.append((category_id, category, bit, tuple(candidates)))
-            # ``span_mask`` is computed once for the whole lexical vector;
-            # rules consume its individual set bits without POS products.
-            for category_id, category, bit, candidates in category_rows:
-                if span_mask & bit:
-                    self._add_derivation(
-                        start, end, category_id, category, bit,
-                        LexicalDerivation(candidates), ("lexical", category_id),
-                    )
-
-    def _add_partial(self, path: PartialPath) -> None:
-        if self.operations >= self.max_items:
-            self.budget_exceeded = True
-            return
-        key = (path.rule_index, path.dot, path.start, path.end)
-        variants = self.partial_seen.setdefault(key, set())
-        if path.children in variants or len(variants) >= self.structural_beam:
-            return
-        variants.add(path.children)
-        self.partial_count += 1
-        self.operations += 1
-        rule = self.compiled.rules[path.rule_index]
-        if path.dot >= len(rule.rhs_ids):
-            derivation = RuleDerivation(path.rule_index, path.children)
-            self._add_derivation(
-                path.start, path.end, rule.lhs_id, rule.rule.lhs.category,
-                rule.lhs_mask, derivation, (path.rule_index, path.children),
-            )
-            return
-        position = self._next_start(path.end)
-        expected_id = rule.rhs_ids[path.dot]
-        self.waiting.setdefault((position, expected_id), []).append(path)
-        for node in tuple(self.by_start_category.get((position, expected_id), ())):
-            if node.mask & rule.rhs_masks[path.dot]:
-                self._advance(path, node)
-
-    def _advance(self, path: PartialPath, node: ForestNode) -> None:
-        rule = self.compiled.rules[path.rule_index]
-        if path.dot >= len(rule.rhs_masks) or not (node.mask & rule.rhs_masks[path.dot]):
-            return
-        self._add_partial(PartialPath(
-            path.rule_index, path.dot + 1, path.start, node.end,
-            path.children + (node.node_id,),
-        ))
-
-    def recognize(self, goal_category: str) -> tuple[ForestNode, ...]:
-        self._seed_lexicon()
-        cursor = 0
-        while cursor < len(self.agenda) and not self.budget_exceeded:
-            node = self.nodes[self.agenda[cursor]]
-            cursor += 1
-            self.operations += 1
-            for rule_index in self.compiled.first.get(node.category_id, ()):
-                rule = self.compiled.rules[rule_index]
-                if node.mask & rule.rhs_masks[0]:
-                    self._add_partial(PartialPath(rule_index, 1, node.start, node.end, (node.node_id,)))
-            for path in tuple(self.waiting.get((node.start, node.category_id), ())):
-                self._advance(path, node)
-        goal_id = intern(goal_category)
-        return tuple(
-            node for node in self.nodes
-            if node.category_id == goal_id and self._root_span(node.start, node.end)
-        )
