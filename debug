-class _Materializer:
-    """Unify and rank compact analyses, then build semantics on demand."""
-
-    def __init__(self, compiled: VectorGrammar, forest: _VectorForest, *, beam: int) -> None:
-        self.compiled = compiled
-        self.forest = forest
-        self.beam = beam
-        self.cache: dict[int, tuple[CompactAnalysis, ...]] = {}
-        self.visiting: set[int] = set()
-        self.item_cache: dict[tuple[str, int], ChartItem] = {}
-        self._analysis_ids = count(1)
-        self.analysis_count = 0
-        self.unification_attempts = 0
-
-    def analyses(self, node_id: int) -> tuple[CompactAnalysis, ...]:
-        cached = self.cache.get(node_id)
-        if cached is not None:
-            return cached
-        if node_id in self.visiting:
-            return ()
-        self.visiting.add(node_id)
-        node = self.forest.nodes[node_id]
-        found: list[CompactAnalysis] = []
-        seen: set[Hashable] = set()
-        for derivation in node.derivations:
-            if isinstance(derivation, LexicalDerivation):
-                for candidate in derivation.candidates:
-                    signature = ("lex", id(candidate))
-                    if signature in seen:
-                        continue
-                    seen.add(signature)
-                    found.append(CompactAnalysis(
-                        next(self._analysis_ids), node_id, candidate.features,
-                        candidate.score, {}, candidate=candidate,
-                    ))
-                continue
-            rule = self.compiled.rules[derivation.rule_index]
-            child_rows = tuple(self.analyses(child) for child in derivation.children)
-            if any(not row for row in child_rows):
-                continue
-            for combo in self._best_combinations(child_rows):
-                env: Bindings = {}
-                uses: list[AnalysisUse] = []
-                valid = True
-                for symbol, child in zip(rule.rule.rhs, combo):
-                    self.unification_attempts += 1
-                    result = unify(symbol.features, child.features, env)
-                    if result is None:
-                        valid = False
-                        break
-                    merged, env = result
-                    uses.append(AnalysisUse(child, merged, dict(env)))
-                if not valid:
-                    continue
-                signature = (derivation.rule_index, tuple(child.analysis_id for child in combo))
-                if signature in seen:
-                    continue
-                seen.add(signature)
-                found.append(CompactAnalysis(
-                    next(self._analysis_ids), node_id,
-                    substitute_structure(rule.rule.lhs.features, env),
-                    # Positive construction weights historically rewarded
-                    # arbitrarily deep unary/wrapper analyses.  A fixed rule
-                    # application cost keeps the intended shallow analysis
-                    # ahead without hiding any structural forest edge.
-                    sum(child.score for child in combo) + rule.rule.score - 0.5,
-                    dict(env), rule_index=derivation.rule_index,
-                    children=tuple(uses),
-                ))
-        self.visiting.remove(node_id)
-        found.sort(key=lambda analysis: analysis.score, reverse=True)
-        result = tuple(found[: self.beam])
-        self.analysis_count += len(result)
-        self.cache[node_id] = result
-        return result
-
-    def _best_combinations(
-        self,
-        rows: tuple[tuple[CompactAnalysis, ...], ...],
-    ) -> Sequence[tuple[CompactAnalysis, ...]]:
-        start = tuple(0 for _ in rows)
-        heap: list[tuple[float, tuple[int, ...]]] = []
-        seen = {start}
-
-        def score(indices: tuple[int, ...]) -> float:
-            return sum(rows[i][index].score for i, index in enumerate(indices))
-
-        heappush(heap, (-score(start), start))
-        out: list[tuple[CompactAnalysis, ...]] = []
-        # Failed feature combinations are common; inspect a bounded multiple
-        # while never enumerating the full Cartesian product.
-        limit = max(8, self.beam * 2)
-        while heap and len(out) < limit:
-            _, indices = heappop(heap)
-            out.append(tuple(rows[i][index] for i, index in enumerate(indices)))
-            for axis in range(len(rows)):
-                nxt = list(indices)
-                nxt[axis] += 1
-                candidate = tuple(nxt)
-                if nxt[axis] >= len(rows[axis]) or candidate in seen:
-                    continue
-                seen.add(candidate)
-                heappush(heap, (-score(candidate), candidate))
-        return out
-
-    def item(self, analysis: CompactAnalysis) -> ChartItem:
