#!/usr/bin/env bash
set -euo pipefail

SEMAN2_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$SEMAN2_ROOT/scripts/activate_local.sh"

usage() {
  cat <<'EOF'
Usage : ./scripts/seman2 COMMANDE [ARGUMENTS]

Commandes :
  install-tools [args] Installe tous les outils localement dans le dépôt
  fetch-corpus [args] Récupère les Parquet canoniques finaux
  verify              Vérifie toutes les dépendances locales
  audit-pocs [args]   Exécute et audite toutes les POC requises
  phase3 [args]       Exécute la chaîne intégrée de proto-services
  sample-corpus       Échantillonne les Parquet réels à mémoire bornée
  plan-services       Planifie les services depuis cet échantillon réel
  evaluate [args]     Compare un artefact à ses attentes explicites
  validate-runtime-plan Valide le graphe runtime cible et la reprise
  runtime-once        Exécute une époque Parquet réelle jusqu'à Soar
  build-data [args]   Construit les Parquet canoniques
  python [args]       Lance le Python principal local
  duckling [args]     Lance le service Duckling local
  popper [args]       Lance Popper dans son environnement isolé
  rst [args]          Lance Python dans l'environnement IsaNLP RST
  help                Affiche cette aide
EOF
}

command_name="${1:-help}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$command_name" in
  install-tools)
    exec "$SEMAN2_ROOT/scripts/install_tools.sh" "$@"
    ;;
  fetch-corpus|corpus)
    exec "$SEMAN2_ROOT/scripts/fetch_corpus.py" "$@"
    ;;
  verify)
    exec "$SEMAN2_ROOT/scripts/verify_local_dependencies.sh" "$@"
    ;;
  audit-pocs)
    exec "$SEMAN2_ROOT/.venv/bin/python" \
      "$SEMAN2_ROOT/scripts/audit_pocs.py" "$@"
    ;;
  phase3)
    exec "$SEMAN2_ROOT/.venv/bin/python" -m seman2_runtime.cli "$@"
    ;;
  sample-corpus)
    exec "$SEMAN2_ROOT/.venv/bin/python" -m seman2_runtime.corpus_cli "$@"
    ;;
  plan-services)
    exec "$SEMAN2_ROOT/.venv/bin/python" -m seman2_runtime.planning_cli "$@"
    ;;
  evaluate)
    exec "$SEMAN2_ROOT/.venv/bin/python" "$SEMAN2_ROOT/scripts/evaluate_poc.py" "$@"
    ;;
  validate-runtime-plan)
    exec "$SEMAN2_ROOT/.venv/bin/python" "$SEMAN2_ROOT/scripts/validate_runtime_plan.py" "$@"
    ;;
  runtime-once)
    exec "$SEMAN2_ROOT/.venv/bin/python" -m seman2_runtime.runtime_cli "$@"
    ;;
  build-data)
    exec "$SEMAN2_ROOT/.venv/bin/python" \
      "$SEMAN2_ROOT/scripts/build_canonical_parquet.py" "$@"
    ;;
  python)
    exec "$SEMAN2_ROOT/.venv/bin/python" "$@"
    ;;
  duckling)
    exec "$SEMAN2_ROOT/.local/opt/duckling/bin/duckling-example-exe" "$@"
    ;;
  popper)
    exec "$SEMAN2_ROOT/scripts/run_popper.sh" "$@"
    ;;
  rst)
    exec "$SEMAN2_ROOT/scripts/run_rst_parser.sh" "$@"
    ;;
  help|-h|--help)
    usage
    ;;
  *)
    printf 'Commande inconnue : %s\n\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac
