    {"from": "system-output-ledger", "to": "observation-ledger", "kind": "feedback", "artifact": "self-produced-observation-ref", "epoch_delta": 1},
    {"from": "situation-state", "to": "situation-state", "kind": "feedback", "artifact": "previous-state-ref", "epoch_delta": 1},
    {"from": "episodic-store", "to": "episodic-store", "kind": "feedback", "artifact": "previous-episode-ref", "epoch_delta": 1},
    {"from": "episodic-store", "to": "induction-engine", "kind": "background", "artifact": "committed-episode-refs", "epoch_delta": 0},
    {"from": "induction-engine", "to": "hypothesis-manager", "kind": "feedback", "artifact": "learned-pattern-ref", "epoch_delta": 1},
    {"from": "hypothesis-manager", "to": "memory-consolidation", "kind": "background", "artifact": "placement-candidates", "epoch_delta": 0},
    {"from": "memory-consolidation", "to": "structural-retrieval", "kind": "feedback", "artifact": "updated-index-ref", "epoch_delta": 1}
  ],
  "checkpoint": {
    "barrier_order": [
      "pause-source-reader",
      "finish-or-record-in-flight-analysis",
      "commit-durable-ledgers-and-index-watermarks",
      "capture-active-context-and-beam",
      "save-soar-agent-procedural-and-semantic-state",
      "backup-soar-episodic-and-semantic-databases",
      "record-soar-input-replay-offset-and-random-seed",
      "write-atomic-checkpoint-manifest",
      "resume-or-stop"
    ],
    "restore_order": [
      "verify-artifact-digests-and-store-watermarks",
      "restore-durable-stores",
      "restore-soar-agent-and-native-memory-databases",
      "rebuild-working-memory-from-active-context-snapshot",
      "replay-only-events-after-checkpoint-watermark",
      "verify-equivalent-active-context-before-resume"
    ],
    "important_limit": "Soar save agent does not by itself establish restoration of the complete current working-memory state."
  },
  "evaluation_plane": {
    "in_runtime_data_path": false,
    "deterministic_oracles_required": true,
    "external_semantic_judge_is_advisory": true,
    "rule": "POCs inspect runtime traces and compare actual results with expectations; they never feed judge output back into cognition."
  }
}
