    },
    {
      "id": "situation-episode-system",
      "layer": 7,
      "modes": ["ingestion", "chatbot"],
      "dependencies": ["semantic-reference-state", "temporal-relation-system", "factorized-hypothesis-manager", "formal-discourse-system", "formal-dialogue-system"],
      "consumes": ["state-update-candidate", "dialogue-state-update-candidate", "temporal-hypothesis", "selection-history"],
      "produces": ["situation-delta", "situation-snapshot", "episode", "memory-index-update"],
      "memory_domains": ["situation-memory", "dialogue-discourse-memory", "episodic-memory"],
      "execution": "reversible state deltas and episodes closed at propagation quiescence",
      "poc_coverage": ["TIME-06", "SOAR-03", "X-03", "X-04"]
    },
    {
      "id": "structural-retrieval",
