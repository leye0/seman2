{
  "purpose": "Canonical executable architecture for the non-LLM learning chatbot. Parquet is an experience source, never an answer store.",
  "runtime_model": {
    "modes": ["ingestion", "chatbot"],
    "shared_cognitive_core": true,
    "primary_live_state": "ram",
    "processing": "typed event propagation in bounded waves",
    "parallelism": "independent formal analyses run in isolated bounded workers",
    "dependency_semantics": "declared dependencies are available producers; a task triggers from matching typed inputs in the current mode and does not wait for mode-inapplicable producers",
    "feedback_rule": "feedback is visible only in a later wave",
    "source_native_structure_preserved": true,
    "evaluation_labels_in_cognition": false,
    "llm_in_cognitive_path": false
  },
  "artifact_contract": {
    "immutable": true,
    "required_fields": [
      "artifact_id",
      "artifact_type",
      "schema_id",
      "producer_id",
      "producer_build",
      "configuration_digest",
      "mode",
      "session_id",
      "observation_refs",
      "episode_refs",
      "wave",
      "derivation_depth",
      "source_anchors",
      "parent_ids",
      "status",
      "justification_ids",
      "contradiction_ids",
      "losses",
      "created_sequence"
    ],
    "native_external_values_are_preserved": true,
    "revision_creates_new_artifact": true,
    "universal_truth_score_forbidden": true
  },
  "control_state": {
    "cognitive_parameters": [
      "max_derivation_depth",
      "activation_floor",
      "hypothesis_beam_width",
      "novelty_reserve",
      "max_active_entities",
      "retrieval_budget",
      "per_module_work_budget",
      "induction_trigger",
      "consolidation_pressure",
      "decay_policy",
      "repair_budget"
    ],
    "hard_safety_limits": [
      "process_ram_limit",
      "worker_count_limit",
      "input_batch_limit",
      "worker_timeout",
      "checkpoint_space_limit"
    ],
    "inactive_is_not_deleted": true,
    "soar_may_adjust_within_safety_envelope": true
  },
  "memory_domains": [
    {"id": "artifact-arena", "live": "ram", "checkpoint": true},
    {"id": "source-observation-memory", "live": "ram+journal", "checkpoint": true},
    {"id": "native-analysis-memory", "live": "ram", "cold_spill": true, "checkpoint": true},
    {"id": "hypothesis-memory", "live": "ram-structural-sharing", "cold_spill": true, "checkpoint": true},
    {"id": "situation-memory", "live": "ram", "checkpoint": true},
    {"id": "dialogue-discourse-memory", "live": "ram", "checkpoint": true},
    {"id": "episodic-memory", "live": "ram-indexed", "cold_spill": true, "checkpoint": true},
    {"id": "learned-graph-memory", "live": "ram-indexed", "cold_spill": true, "checkpoint": true},
    {"id": "retrieval-index-memory", "live": "ram-indexed", "checkpoint": true},
    {"id": "soar-working-memory", "live": "ram-bounded", "checkpoint": "reconstructible"},
    {"id": "soar-native-memory", "live": "soar-native", "checkpoint": true},
    {"id": "control-state-memory", "live": "ram", "checkpoint": true},
    {"id": "scheduler-memory", "live": "ram", "checkpoint": true},
    {"id": "cold-store", "live": "disk", "reconstructible": true},
    {"id": "checkpoint-store", "live": "disk-atomic", "runtime_reasoning": false}
  ],
  "service_families": [
    {
      "id": "corpus-ingestion",
      "layer": 0,
      "modes": ["ingestion"],
      "dependencies": [],
      "consumes": ["parquet-shard", "text-document", "dictionary-jsonl", "corpus-cursor", "curriculum-policy"],
      "produces": ["source-event", "source-segment", "source-relation"],
      "memory_domains": ["source-observation-memory", "scheduler-memory"],
      "execution": "bounded sequential reader for Parquet, text and dictionary JSONL; preserves source order, native structure and raw values; dictionary definitions remain input observations and never become direct lexical truth",
      "poc_coverage": ["RUN-03"]
    },
    {
      "id": "interaction-ingestion",
      "layer": 0,
      "modes": ["chatbot"],
      "dependencies": [],
      "consumes": ["user-turn", "channel-context"],
      "produces": ["source-event", "source-segment", "source-relation"],
      "memory_domains": ["source-observation-memory"],
      "execution": "online adapter; same downstream contracts as corpus ingestion",
      "poc_coverage": ["X-03"]
    },
    {
      "id": "curriculum-controller",
      "layer": 0,
      "modes": ["ingestion"],
      "dependencies": [],
      "consumes": ["corpus-catalog", "observed-complexity-metrics", "control-state"],
      "produces": ["curriculum-policy"],
      "memory_domains": ["control-state-memory"],
      "execution": "orders experience by tractability; never exposes target answers to cognition",
      "poc_coverage": ["X-01", "X-07"]
    },
    {
      "id": "source-observation-provenance",
      "layer": 1,
      "modes": ["ingestion", "chatbot"],
      "dependencies": ["corpus-ingestion", "interaction-ingestion"],
      "consumes": ["source-event", "source-segment", "source-relation"],
      "produces": ["observation", "observable-unit", "source-anchor", "transmission-event"],
      "memory_domains": ["source-observation-memory", "artifact-arena"],
      "execution": "immutable Source, Observation and Transmission/Provenance graphs",
      "poc_coverage": ["DLG-01", "GRAPH-02", "NLP-04", "X-02"]
    },
    {
      "id": "formal-analysis-dispatch",
      "layer": 2,
      "modes": ["ingestion", "chatbot"],
      "dependencies": ["source-observation-provenance"],
      "consumes": ["observation", "observable-unit", "control-state"],
      "produces": ["analysis-job", "analysis-timeout", "analysis-failure"],
      "memory_domains": ["scheduler-memory", "control-state-memory"],
      "execution": "parallel bounded jobs with modality routing, timeouts and backpressure",
      "poc_coverage": ["GRAPH-01"]
    },
    {
      "id": "erg-deep-grammar",
      "layer": 2,
      "modes": ["ingestion", "chatbot"],
      "dependencies": ["formal-analysis-dispatch"],
      "consumes": ["analysis-job:text"],
      "produces": ["hpsg-analysis", "mrs-analysis", "eds-analysis", "dmrs-analysis"],
      "memory_domains": ["native-analysis-memory"],
      "execution": "isolated ACE/ERG worker preserving all candidates and anchors",
      "poc_coverage": ["NLP-01", "NLP-02", "NLP-03"]
    },
    {
      "id": "link-grammar-analysis",
      "layer": 2,
      "modes": ["ingestion", "chatbot"],
      "dependencies": ["formal-analysis-dispatch"],
      "consumes": ["analysis-job:text"],
      "produces": ["linkage-analysis"],
      "memory_domains": ["native-analysis-memory"],
      "execution": "isolated Link Grammar worker preserving competing linkages",
      "poc_coverage": ["NLP-05", "NLP-06"]
    },
    {
      "id": "incremental-dialogue-grammar",
      "layer": 2,
      "modes": ["ingestion", "chatbot"],
      "dependencies": ["formal-analysis-dispatch"],
      "consumes": ["analysis-job:text", "prior-incremental-state"],
      "produces": ["dynamic-syntax-state", "native-ttr-analysis"],
      "memory_domains": ["native-analysis-memory", "dialogue-discourse-memory"],
      "execution": "incremental Dynamic Syntax processing; partial states are first-class",
      "poc_coverage": ["DLG-02", "DLG-03"]
    },
    {
      "id": "lexical-resource-analysis",
      "layer": 2,
      "modes": ["ingestion", "chatbot"],
      "dependencies": ["formal-analysis-dispatch"],
      "consumes": ["analysis-job:text", "source-anchor"],
      "produces": ["lexical-sense-candidate", "frame-candidate", "role-candidate", "ontology-link-candidate"],
      "memory_domains": ["native-analysis-memory"],
      "execution": "occurrence-scoped WordNet, VerbNet, PropBank, FrameNet, SemLink and SUMO lookup",
      "poc_coverage": ["LEX-01", "LEX-02", "LEX-03", "LEX-04", "LEX-05", "LEX-06", "LEX-07"]
    },
    {
      "id": "form-phonology-analysis",
      "layer": 2,
      "modes": ["ingestion", "chatbot"],
      "dependencies": ["formal-analysis-dispatch"],
      "consumes": ["analysis-job:text", "source-anchor"],
      "produces": ["phonological-transcription", "phonological-feature-structure", "form-transduction-candidate", "g2p-candidate"],
      "memory_domains": ["native-analysis-memory"],
      "execution": "attributed Epitran, PanPhon and WFST/G2P candidates without destructive normalization",
      "poc_coverage": ["SEM-01", "SEM-02", "SEM-03", "SEM-04"]
    },
    {
      "id": "code-analysis",
      "layer": 2,
      "modes": ["ingestion", "chatbot"],
      "dependencies": ["formal-analysis-dispatch"],
      "consumes": ["analysis-job:code", "source-anchor"],
      "produces": ["tree-sitter-analysis", "code-error-node"],
      "memory_domains": ["native-analysis-memory"],
      "execution": "language-routed Tree-sitter worker retaining incomplete and invalid structures",
      "poc_coverage": ["CODE-01", "CODE-02"]
    },
    {
      "id": "temporal-surface-analysis",
      "layer": 2,
      "modes": ["ingestion", "chatbot"],
      "dependencies": ["formal-analysis-dispatch"],
      "consumes": ["analysis-job:text", "external-calendar-context"],
      "produces": ["quarantined-temporal-annotation"],
      "memory_domains": ["native-analysis-memory"],
      "execution": "HeidelTime/Duckling annotations remain external evidence",
      "poc_coverage": ["TIME-08"]
    },
    {
      "id": "rst-discourse-analysis",
      "layer": 2,
      "modes": ["ingestion", "chatbot"],
      "dependencies": ["formal-analysis-dispatch"],
      "consumes": ["analysis-job:discourse-unit"],
      "produces": ["native-rst-analysis"],
      "memory_domains": ["native-analysis-memory"],
      "execution": "isolated memory-bounded IsaNLP RST worker",
      "poc_coverage": ["DISC-01", "DISC-02"]
    },
    {
      "id": "native-analysis-ledger",
      "layer": 3,
      "modes": ["ingestion", "chatbot"],
      "dependencies": ["erg-deep-grammar", "link-grammar-analysis", "incremental-dialogue-grammar", "lexical-resource-analysis", "form-phonology-analysis", "code-analysis", "temporal-surface-analysis", "rst-discourse-analysis"],
      "consumes": ["native-analysis", "analysis-failure", "analysis-timeout"],
      "produces": ["attributed-native-analysis", "attributed-analysis-failure"],
      "memory_domains": ["native-analysis-memory", "artifact-arena"],
      "execution": "records partial, failed and successful analyses independently",
      "poc_coverage": ["GRAPH-03", "X-01"]
    },
    {
      "id": "representation-adapters",
      "layer": 3,
      "modes": ["ingestion", "chatbot"],
      "dependencies": ["native-analysis-ledger"],
