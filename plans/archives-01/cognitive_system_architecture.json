  "feedback_paths": [
    {"from": "induction-engine", "to": "cross-representation-linker", "visible_after_waves": 1, "matter": "learned-relation"},
    {"from": "induction-engine", "to": "semantic-reference-state", "visible_after_waves": 1, "matter": "learned-concept"},
    {"from": "cultural-concept-system", "to": "factorized-hypothesis-manager", "visible_after_waves": 1, "matter": "nonliteral-interpretation-candidate"},
