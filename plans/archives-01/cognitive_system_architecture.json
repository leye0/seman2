      "produces": ["alignment-candidate", "identity-candidate", "cross-representation-hypothesis"],
      "memory_domains": ["hypothesis-memory"],
      "execution": "links syntax, semantics, form, sound, code and context without representation collapse",
      "poc_coverage": ["SEM-05", "SEM-06", "NLP-06", "DLG-03", "X-06"]
    },
    {
      "id": "constraint-engine",
      "layer": 4,
