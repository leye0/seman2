      "memory_domains": ["situation-memory", "hypothesis-memory"],
      "execution": "compositional meaning and particular state projection without hardcoded cognitive ontology",
      "poc_coverage": ["X-03"]
    },
    {
      "id": "temporal-relation-system",
      "layer": 4,
      "modes": ["ingestion", "chatbot"],
      "dependencies": ["source-observation-provenance", "representation-adapters", "semantic-reference-state", "constraint-engine", "temporal-surface-analysis"],
      "consumes": ["source-order", "event-candidate", "quarantined-temporal-annotation", "prior-temporal-context"],
      "produces": ["temporal-constraint-network", "event-reference-speech-structure", "temporal-hypothesis", "episodic-temporal-context"],
      "memory_domains": ["hypothesis-memory", "episodic-memory"],
      "execution": "Allen, Reichenbach E/R/S, aspect, persistence, discourse anaphora and non-destructive revision",
      "poc_coverage": ["TIME-01", "TIME-02", "TIME-03", "TIME-04", "TIME-05", "TIME-06", "TIME-07"]
    },
    {
