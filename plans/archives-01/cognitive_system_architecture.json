    {"from": "surface-realization", "to": "interaction-ingestion", "visible_after_waves": 1, "matter": "system-utterance"}
  ],
  "ingestion_flow": [
    "corpus-ingestion",
    "source-observation-provenance",
    "formal-analysis-dispatch",
    "parallel-formal-analyzers",
