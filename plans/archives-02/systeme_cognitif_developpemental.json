      "layer": 5,
      "modes": ["ingestion", "chatbot"],
      "dependencies": ["relational-universe", "memory-system", "executive-soar"],
      "consumes": ["relational-world-view", "L4-live-memory", "mental-operator"],
      "produces": ["active-context-view", "episode-outcome"],
      "owns": ["discourse-context", "dialogue-gameboard", "QUD", "grounding", "commitments", "obligations"],
      "raw_source_access": false
    },
    {
      "id": "communicative-planner",
      "layer": 6,
      "modes": ["chatbot"],
      "dependencies": ["executive-soar", "active-situation", "memory-system"],
      "consumes": ["mental-operator", "active-context-view", "L4-live-memory"],
