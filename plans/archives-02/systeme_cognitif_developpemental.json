      "owns": ["immutable-observations"],
      "raw_source_access": false
    },
    {
      "id": "analysis-orchestrator",
      "layer": 1,
      "modes": ["ingestion", "chatbot"],
      "dependencies": ["observation-register"],
      "consumes": ["observation-reference"],
      "produces": ["bounded-analysis-job", "non-applicability-reason"],
      "owns": ["wave-jobs", "analysis-barrier"],
      "raw_source_access": false
    },
    {
      "id": "low-level-workers",
      "layer": 1,
      "modes": ["ingestion", "chatbot"],
      "dependencies": ["analysis-orchestrator", "observation-register"],
