    {
      "id": "surface-realizer",
      "layer": 7,
      "modes": ["chatbot"],
      "dependencies": ["communicative-planner"],
      "consumes": ["L6-mental-communicative-plan"],
      "produces": ["L7-realized-action-turn"],
      "owns": [],
      "raw_source_access": false
    },
    {
      "id": "audit-checkpoint",
      "layer": 8,
      "modes": ["ingestion", "chatbot"],
      "dependencies": [],
      "consumes": ["causal-transition-copy", "coordinated-snapshot"],
      "produces": ["audit-record", "restart-state"],
      "owns": ["external-audit-journal", "checkpoints"],
      "raw_source_access": false
    },
    {
      "id": "external-tutor-evaluator",
      "layer": 8,
      "modes": ["evaluation"],
      "dependencies": ["surface-realizer"],
      "consumes": ["L7-realized-action-turn", "predeclared-rubric"],
      "produces": ["tutor-feedback", "external-score"],
      "owns": ["rubrics", "evaluation-records"],
      "raw_source_access": false
    }
  ],
  "allowed_feedback_edges": [
    ["induction", "formal-composer", "next-wave-only"],
    ["induction", "distributed-forms", "next-wave-only"],
    ["memory-system", "distributed-forms", "state-read-only"],
    ["active-situation", "formal-composer", "state-read-only"],
    ["active-situation", "executive-soar", "state-read-only"],
    ["surface-realizer", "experience-gateway", "next-turn-only"],
    ["external-tutor-evaluator", "experience-gateway", "attributed-experience-only"]
  ],
  "forbidden_paths": [
    "raw-source-to-high-level-component",
    "audit-journal-to-cognitive-retrieval",
    "dictionary-to-semantic-memory",
    "lexical-bank-to-world-truth",
    "external-evaluator-to-runtime-write",
    "surface-analyzer-to-cultural-interpretation",
    "realizer-to-content-selection"
  ],
  "required_poc_order": [
    "SYS-01", "SYS-02", "SYS-03", "SYS-04", "SYS-05", "SYS-06",
    "SYS-07", "SYS-08", "SYS-09", "SYS-10", "SYS-11", "SYS-12", "SYS-13"
  ]
}
