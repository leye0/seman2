{
  "authority": "plans/architecture_cognitive_developpementale.md",
  "artifact_levels": [
    "L0-experience-observation",
    "L1-analysis-contribution",
    "L2-composed-candidate",
    "L3-situation-branch-delta",
    "L4-live-memory",
    "L5-learned-structure",
    "L6-mental-communicative-plan",
    "L7-realized-action-turn"
  ],
  "components": [
    {
      "id": "experience-gateway",
      "layer": 0,
      "modes": ["ingestion", "chatbot"],
      "dependencies": [],
